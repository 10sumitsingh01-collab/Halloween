# Database connection URL (e.g. sqlite:///./medmate.db)
DATABASE_URL=

# Caregiver authentication API key
CAREGIVER_API_KEY=

# Patient authentication API key
PATIENT_API_KEY=

# Default IANA timezone for reminder scheduling
DEFAULT_TIMEZONE=

# Window in minutes around due time where dose is marked taken
TAKEN_WINDOW_MINUTES=

# Window in minutes after due time before dose confirmation closes
LATE_WINDOW_MINUTES=

# Window in minutes to guard against duplicate confirmations
DOUBLE_DOSE_GUARD_MINUTES=

# Window in minutes before due time allowing early dose confirmation
EARLY_WINDOW_MINUTES=

# Default snooze duration in minutes
DEFAULT_SNOOZE_MINUTES=

# Maximum allowed snooze duration in minutes
MAX_SNOOZE_MINUTES=

# Interval in minutes between repeated patient reminders
REMINDER_REPEAT_MINUTES=

# Maximum number of reminder notifications sent to patient
MAX_PATIENT_REMINDERS=

# Delay in minutes before unconfirmed dose escalates to caregivers
CAREGIVER_ESCALATION_MINUTES=

# Scheduler loop tick interval in seconds
SCHEDULER_TICK_SECONDS=

# Enable or disable background escalation scheduler loop (true/false)
SCHEDULER_ENABLED=

# Lookback window in hours for evaluating overdue doses
ESCALATION_LOOKBACK_HOURS=

# Maximum age in minutes to dispatch alerts for missed doses
MISSED_ALERT_MAX_AGE_MINUTES=

# Notification provider channel (e.g. mock or telegram)
NOTIFIER_CHANNEL=

# Telegram Bot API token
TELEGRAM_BOT_TOKEN=

# Enable or disable background Telegram update poller (true/false)
TELEGRAM_POLL_ENABLED=

# Scoped API key for assistant / watch test endpoints
ASSISTANT_API_KEY=

# Integer patient ID strictly bound to the assistant API key
ASSISTANT_PATIENT_ID=

# Cooldown window in minutes between assistant caregiver alerts
ALERT_COOLDOWN_MINUTES=

# Google AI Studio API key for Gemini services
GOOGLE_API_KEY=
